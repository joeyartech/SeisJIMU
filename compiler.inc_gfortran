#GIT_COMMIT:=$(shell git rev-parse HEAD)
GIT_COMMIT:=$(shell git rev-parse --short HEAD)
GIT_BRANCH:=$(shell git rev-parse --abbrev-ref HEAD)

F90=mpif90 -fdollar-ok
F77=mpif77 -fdollar-ok

FLAGF77= -Ofast -fopenmp                         -fbacktrace  #-flto
FLAGF90= -Ofast -fopenmp -ffree-line-length-none -fbacktrace  -fno-unsafe-math-optimizations -frounding-math -fsignaling-nans

#FLAGF77= -g -Wall -Wno-tabs -fopenmp -fcheck=all                         -fbacktrace
#FLAGF90= -g -Wall -Wno-tabs -fopenmp -fcheck=all -ffree-line-length-none -fbacktrace -fno-strict-aliasing

FPP=-cpp -Dgfortran -D"git_commit='$(GIT_COMMIT)'" -D"git_branch='$(GIT_BRANCH)'"

MOD=-J $(mod_dir)


.SUFFIX : %.f %.f90 %.o

%.o : %.f90
	$(F90) $(FPP) $(ETC) $(FLAGF90) $(MOD) -c $^ -o $@
	@printf "\n"	

%.o : %.f
	$(F77)        $(ETC) $(FLAGF77)        -c $^ -o $@
	@printf "\n"
